{
  "openapi": "3.1.0",
  "info": {
    "title": "Nora Synth API",
    "version": "0.1.0",
    "description": "Standalone preset API. All preset operations are scoped to the authenticated owner. The opaque Bearer secret maps to a configured stable AUTH_OWNER_ID; rotate AUTH_SECRET while preserving AUTH_OWNER_ID to retain access. Ownership is never accepted from callers or exposed in responses. The current server supports one configured identity at a time."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Configured AUTH_SECRET: Authorization: Bearer <secret>."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "nora-synth-api"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "service",
          "status"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "INVALID_JSON",
                  "UNAUTHORIZED",
                  "NOT_FOUND",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "INTERNAL_ERROR",
                  "NOT_READY"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "PresetList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Preset"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "limit",
          "offset",
          "total"
        ],
        "additionalProperties": false,
        "example": {
          "items": [
            {
              "name": "Soft Motion",
              "schemaVersion": 1,
              "parameters": {
                "filter": 0.5,
                "mood": 0.5,
                "movement": 0.5,
                "space": 0.5,
                "expression": 0.5,
                "attack": 0.5,
                "decay": 0.5,
                "sustain": 0.5,
                "release": 0.5
              },
              "id": "123e4567-e89b-42d3-a456-426614174000",
              "createdAt": "2026-10-20T12:00:00.000Z",
              "updatedAt": "2026-10-20T12:00:00.000Z"
            }
          ],
          "limit": 50,
          "offset": 0,
          "total": 1
        }
      },
      "Preset": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Trimmed before validation; must contain 1–100 characters after trimming."
          },
          "schemaVersion": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "parameters": {
            "$ref": "#/components/schemas/SynthParameters"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "schemaVersion",
          "parameters",
          "id",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "example": {
          "name": "Soft Motion",
          "schemaVersion": 1,
          "parameters": {
            "filter": 0.5,
            "mood": 0.5,
            "movement": 0.5,
            "space": 0.5,
            "expression": 0.5,
            "attack": 0.5,
            "decay": 0.5,
            "sustain": 0.5,
            "release": 0.5
          },
          "id": "123e4567-e89b-42d3-a456-426614174000",
          "createdAt": "2026-10-20T12:00:00.000Z",
          "updatedAt": "2026-10-20T12:00:00.000Z"
        }
      },
      "SynthParameters": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mood": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "movement": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "space": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "expression": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "attack": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "decay": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sustain": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "release": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "filter",
          "mood",
          "movement",
          "space",
          "expression",
          "attack",
          "decay",
          "sustain",
          "release"
        ],
        "additionalProperties": false
      },
      "PresetInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Trimmed before validation; must contain 1–100 characters after trimming."
          },
          "schemaVersion": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "parameters": {
            "$ref": "#/components/schemas/SynthParameters"
          }
        },
        "required": [
          "name",
          "schemaVersion",
          "parameters"
        ],
        "additionalProperties": false,
        "example": {
          "name": "Soft Motion",
          "schemaVersion": 1,
          "parameters": {
            "filter": 0.5,
            "mood": 0.5,
            "movement": 0.5,
            "space": 0.5,
            "expression": 0.5,
            "attack": 0.5,
            "decay": 0.5,
            "sustain": 0.5,
            "release": 0.5
          }
        }
      },
      "RenameInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Trimmed before validation; must contain 1–100 characters after trimming."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "example": {
          "name": "Soft Motion II"
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Report service liveness",
        "description": "Does not query the database.",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Check database readiness",
        "description": "Runs SELECT 1 with bounded database connection and query timeouts. Does not verify migrations.",
        "security": [],
        "responses": {
          "200": {
            "description": "Database is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string",
                      "enum": [
                        "nora-synth-api"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  },
                  "required": [
                    "service",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable. Returns NOT_READY without internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/presets": {
      "get": {
        "operationId": "listPresets",
        "summary": "List the authenticated owner’s presets",
        "description": "Ordered by updated_at descending, then UUID ascending. Total counts this owner’s records independently of pagination. Unknown query parameters are rejected. Empty pages have items: [].",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of presets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresetList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination or unknown query parameter. Returns VALIDATION_ERROR with field paths and messages in details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or incorrect Bearer credentials. Authentication precedes validation and persistence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error. Returns INTERNAL_ERROR without internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPreset",
        "summary": "Save a complete preset",
        "description": "All nine normalized controls are required. Names are trimmed before length validation. Unknown fields, including ownerId, are rejected. Duplicate names are allowed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresetInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Preset created with a server-generated UUID and timestamps.",
            "headers": {
              "Location": {
                "description": "Relative URL of the created preset.",
                "required": true,
                "schema": {
                  "type": "string"
                },
                "example": "/v1/presets/123e4567-e89b-42d3-a456-426614174000"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preset"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body returns VALIDATION_ERROR with field paths and messages in details. Malformed JSON returns INVALID_JSON. For PATCH and PUT, invalid UUID also returns VALIDATION_ERROR. Authentication and Content-Type are checked first, then UUID, then body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or incorrect Bearer credentials. Authentication precedes validation and persistence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json. Charset parameters are accepted. Returns UNSUPPORTED_MEDIA_TYPE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error. Returns INTERNAL_ERROR without internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/presets/{id}": {
      "get": {
        "operationId": "getPreset",
        "summary": "Retrieve an owned preset",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Full preset.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preset"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID. Returns VALIDATION_ERROR: Preset ID must be a valid UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or incorrect Bearer credentials. Authentication precedes validation and persistence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Preset does not exist or belongs to another owner. Returns NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error. Returns INTERNAL_ERROR without internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "renamePreset",
        "summary": "Rename an owned preset",
        "description": "Trims and updates name and updatedAt while preserving all other fields. Unknown fields are rejected. Does not create missing presets.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Renamed preset.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preset"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body returns VALIDATION_ERROR with field paths and messages in details. Malformed JSON returns INVALID_JSON. For PATCH and PUT, invalid UUID also returns VALIDATION_ERROR. Authentication and Content-Type are checked first, then UUID, then body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or incorrect Bearer credentials. Authentication precedes validation and persistence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Preset does not exist or belongs to another owner. Returns NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json. Charset parameters are accepted. Returns UNSUPPORTED_MEDIA_TYPE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error. Returns INTERNAL_ERROR without internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replacePreset",
        "summary": "Replace a complete owned preset",
        "description": "Replaces name, schemaVersion, and all nine parameters; updates updatedAt. Trims names and rejects unknown fields. Preserves id and createdAt. Does not create missing presets.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replaced preset.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preset"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body returns VALIDATION_ERROR with field paths and messages in details. Malformed JSON returns INVALID_JSON. For PATCH and PUT, invalid UUID also returns VALIDATION_ERROR. Authentication and Content-Type are checked first, then UUID, then body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or incorrect Bearer credentials. Authentication precedes validation and persistence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Preset does not exist or belongs to another owner. Returns NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json. Charset parameters are accepted. Returns UNSUPPORTED_MEDIA_TYPE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error. Returns INTERNAL_ERROR without internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePreset",
        "summary": "Delete an owned preset",
        "description": "Subsequent recall or deletion returns 404.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted successfully; no response body."
          },
          "400": {
            "description": "Invalid UUID. Returns VALIDATION_ERROR: Preset ID must be a valid UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or incorrect Bearer credentials. Authentication precedes validation and persistence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Preset does not exist or belongs to another owner. Returns NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error. Returns INTERNAL_ERROR without internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
